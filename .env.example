# ----------------------------------------
# Account 1 Setup
# ----------------------------------------
CF_ACCOUNT_ID_1=your_cloudflare_account_id_1
CF_API_TOKEN_1=your_cloudflare_api_token_1
# (Optional) A manual backup name if the Cloudflare API cannot be reached:
CF_ACCOUNT_NAME_1=My First Account

# ----------------------------------------
# Account 2 Setup
# ----------------------------------------
CF_ACCOUNT_ID_2=your_cloudflare_account_id_2
CF_API_TOKEN_2=your_cloudflare_api_token_2
CF_ACCOUNT_NAME_2=My Second Account

# ----------------------------------------
# Account 3 Setup (Add up to Account 10)
# ----------------------------------------
CF_ACCOUNT_ID_3=your_cloudflare_account_id_3
CF_API_TOKEN_3=your_cloudflare_api_token_3
CF_ACCOUNT_NAME_3=My Third Account

# ...and so on, up to CF_ACCOUNT_ID_10 / CF_API_TOKEN_10

# ----------------------------------------
# Optional: Local Development/Mocking Mode
# ----------------------------------------
# Set this to "true" if you want to test the UI locally with mock data 
# without querying the real Cloudflare API.
MOCK_CF=false

